#!/usr/bin/env bash
# ctxprobe — find the largest context a GGUF actually runs at on one GPU.
#
# Estimators tell you a context size should fit. ctxprobe proves it runs: every
# candidate is booted for real and fed a ladder of prompts — 64, 512, 4096
# tokens — stopping at the first one that kills it. A larger prefill instantiates
# CUDA kernels a shorter one never touches, and loading one for the first time
# needs device memory a nearly-full card hasn't got, so a config can load fine,
# decode an 18-token prompt at full speed, and still CUDA-OOM on a 64-token one.
# The winner is then re-validated once against a prompt that fills the window.
# If that fails — a model whose buffers grow with the tokens already cached, as
# sparse attention with an indexer does — the search runs again below it,
# validating every probe at full length, and reports the size that held.
#
# Usage:
#   ctxprobe MODEL.gguf [options] [-- extra llama-server args]
#
# Options:
#   --min N           lower bound for the search (default 2048)
#   --max N           upper bound (default: model's trained context, capped 262144)
#   --step N          granularity (default 256 — llama.cpp pads n_ctx to 256)
#   --kv TYPE         KV cache type: q8_0 (default), f16, q4_0, ...
#   --parallel N      server slots (default 1; the default of 4 quadruples KV)
#   --ngl N           layers on GPU (default 999 = all). Lower values spill to
#                     system RAM — useful for measuring what overflow costs,
#                     but then a PASS no longer means "ran entirely on the GPU"
#   --list "A B C"    test these sizes instead of binary-searching
#   --fill PCT        how full the winner's validation prompt is, 1-100
#                     (default 95). Measured with the server tokenizer, so it is
#                     the real figure. The search itself stops at 4096 tokens
#   --port N          port for the probe server (default 6099)
#   --out DIR         where logs and results.tsv go (default ./ctxprobe-out)
#   --eager           set CUDA_MODULE_LOADING=EAGER: loads every kernel up front
#                     so the answer doesn't depend on which kernels this run
#                     happened to touch. Gives a smaller but portable ceiling
#   --json            emit machine-readable JSON to stdout
#   --keep            don't delete per-run logs
set -uo pipefail

die() { echo "ctxprobe: $*" >&2; exit 1; }

MODEL=""; MIN=2048; MAX=""; STEP=256; KV="q8_0"; PARALLEL=1; NGL=999
LIST=""; FILL=95; PORT=6099; OUT="./ctxprobe-out"; JSON=0; KEEP=0; EAGER=0
EXTRA=()   # expanded as ${EXTRA[@]+...} so bash 3.2 tolerates it empty under set -u

val() {  # val <flag> <value?> — reject a missing or non-numeric argument
  [[ -n "${2:-}" ]] || die "$1 needs a value"
  case "$1" in
    --kv) ;;
    # A leading zero would reach bash arithmetic as an octal literal, where 08
    # is a syntax error rather than eight, so reject it at the boundary.
    *) [[ "$2" =~ ^(0|[1-9][0-9]*)$ ]] || die "$1 needs a number without a leading zero, got: $2" ;;
  esac
  printf '%s' "$2"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --min) MIN=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --max) MAX=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --step) STEP=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --kv) KV=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --parallel) PARALLEL=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --ngl) NGL=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --list) [[ -n "${2:-}" ]] || die "--list needs a value"; LIST="$2"; shift 2 ;;
    --fill) FILL=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --port) PORT=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --out) [[ -n "${2:-}" ]] || die "--out needs a value"; OUT="$2"; shift 2 ;;
    --eager) EAGER=1; shift ;;
    --json) JSON=1; shift ;;
    --keep) KEEP=1; shift ;;
    -h|--help) sed -n '2,/^set /p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; EXTRA=("$@"); break ;;
    -*) die "unknown option: $1" ;;
    *) [[ -z "$MODEL" ]] && MODEL="$1" || die "unexpected argument: $1"; shift ;;
  esac
done

[[ -n "$MODEL" ]] || die "usage: ctxprobe MODEL.gguf [options]  (--help for more)"
[[ -f "$MODEL" ]] || die "model not found: $MODEL"
(( FILL >= 1 && FILL <= 100 )) || die "--fill must be between 1 and 100, got: $FILL"

LLAMA_BIN="${LLAMA_SERVER:-$(command -v llama-server || echo "${HOME:-}/llama.cpp/build/bin/llama-server")}"
[[ -x "$LLAMA_BIN" ]] || die "llama-server not found. Set LLAMA_SERVER=/path/to/llama-server"
command -v nvidia-smi >/dev/null || die "nvidia-smi not found (NVIDIA GPU required)"
command -v python3   >/dev/null || die "python3 required"

mkdir -p "$OUT"

# --------------------------------------------------------------- capabilities
# nvidia-smi's total includes a driver reserve that no allocation can touch
# (~460 MiB on a 16 GB card). Headroom measured against it is fiction, so ask
# CUDA what it really exposes when a torch build happens to be available.
# Everything must report the GPU this run actually uses. Taking index 0 blindly
# reads another card's usage on a multi-GPU box, which silently invalidates
# every VRAM figure below.
GPU_IDX="${CUDA_VISIBLE_DEVICES-}"; GPU_IDX="${GPU_IDX%%,*}"; GPU_IDX="${GPU_IDX:-0}"
smi() { nvidia-smi -i "$GPU_IDX" "$@"; }
VRAM_TOTAL=$(smi --query-gpu=memory.total --format=csv,noheader,nounits | head -1)
VRAM_BASE=$(smi --query-gpu=memory.used --format=csv,noheader,nounits | head -1)
read_usable() {
  # Must be cudaMemGetInfo, which is what CUDA will actually hand out.
  # NVML/nvidia-smi report the physical size of the board instead — using those
  # yields a driver reserve of 0 and hides the very gap this is here to expose.
  # Only the total is wanted. The free figure this call also returns is measured
  # from inside a CUDA context that torch had to create, and that context holds
  # ~135 MiB on an idle 16 GB card — it would be reported as somebody else's
  # usage even though it is gone before llama-server starts. What other
  # processes hold comes from nvidia-smi instead, at the point of use below.
  local snippet='import torch
print(int(torch.cuda.mem_get_info()[1] / 2**20))'
  local py
  for py in "${CTXPROBE_PYTHON:-}" python3 \
            "${HOME:-}/miniconda3/envs/"*/bin/python "${HOME:-}/venv/bin/python" ; do
    [[ -n "$py" && -x "$(command -v "$py" 2>/dev/null)" ]] || continue
    local v; v=$("$py" -c "$snippet" 2>/dev/null)
    [[ -n "$v" ]] && { echo "$v"; return 0; }
  done
  return 1
}
VRAM_USABLE=$(read_usable || true)
[[ "$VRAM_USABLE" =~ ^[0-9]+$ ]] || VRAM_USABLE=""
GPU_NAME=$(smi --query-gpu=name --format=csv,noheader | head -1)
# Lazy vs eager module loading decides when a kernel's code is pulled into VRAM,
# which moves the ceiling. Two machines set differently give different answers,
# so record it rather than leaving the discrepancy unexplained.
(( EAGER )) && export CUDA_MODULE_LOADING=EAGER
CUDA_LOADING="${CUDA_MODULE_LOADING:-LAZY (default)}"
# Flash attention moves the ceiling too, and nothing in the server's output or
# /props reports it. Quantised V cache cannot run without it — llama.cpp refuses
# to start with "V cache quantization requires flash_attn" — so a quantised KV
# type pins it on regardless of what -fa says.
FLASH_ATTN="auto"
_prev=""
for _a in ${EXTRA[@]+"${EXTRA[@]}"}; do
  # Only accept a real value: older llama-server takes -fa as a boolean flag, so
  # blindly reading the next argument reports "-ngl" as the flash-attn setting.
  case "$_prev" in
    -fa|--flash-attn)
      case "$_a" in on|off|auto|0|1) FLASH_ATTN="$_a" ;; esac ;;
  esac
  _prev="$_a"
done
if [[ "$KV" == q* ]]; then
  if [[ "$FLASH_ATTN" == off || "$FLASH_ATTN" == 0 ]]; then
    FLASH_ATTN="off requested — llama-server will refuse to start with quantised KV"
  else
    FLASH_ATTN="on (forced by quantised V cache)"
  fi
fi

# Trained context length, so --max defaults to something the model supports.
if [[ -z "$MAX" ]]; then
  MAX=$(python3 - "$MODEL" <<'PY' 2>/dev/null || true
import struct, sys
# Minimal GGUF reader: walk the KV table looking for *.context_length.
f = open(sys.argv[1], 'rb')
if f.read(4) != b'GGUF': sys.exit(1)
ver = struct.unpack('<I', f.read(4))[0]
n_tensors, n_kv = struct.unpack('<QQ', f.read(16))
def rd_str():
    (n,) = struct.unpack('<Q', f.read(8)); return f.read(n).decode('utf-8', 'replace')
SCALAR = {0:'<b',1:'<B',2:'<h',3:'<H',4:'<i',5:'<I',6:'<f',7:'<?',10:'<q',11:'<Q',12:'<d'}
SIZE   = {0:1,1:1,2:2,3:2,4:4,5:4,6:4,7:1,10:8,11:8,12:8}
def rd_val(t):
    if t == 8: return rd_str()
    if t == 9:
        (et,) = struct.unpack('<I', f.read(4)); (n,) = struct.unpack('<Q', f.read(8))
        return [rd_val(et) for _ in range(n)]
    return struct.unpack(SCALAR[t], f.read(SIZE[t]))[0]
for _ in range(n_kv):
    k = rd_str(); (t,) = struct.unpack('<I', f.read(4)); v = rd_val(t)
    if k.endswith('.context_length'):
        print(min(int(v), 262144)); sys.exit(0)
sys.exit(1)
PY
)
  [[ -n "$MAX" ]] || MAX=32768
fi

(( STEP > 0 )) || die "--step must be at least 1"
round_step() { echo $(( ($1 / STEP) * STEP )); }
# Round the bounds *inward*: a search that reported a size below the requested
# --min would be answering a question that wasn't asked.
MIN=$(( ((MIN + STEP - 1) / STEP) * STEP ))
MAX=$(round_step "$MAX")
(( MIN >= STEP )) || MIN=$STEP
(( MAX >= MIN )) || die "--max ($MAX) is below --min ($MIN) once both are rounded to --step ($STEP)"

# Only ever kill the server this script started. Matching on the port would also
# take out a server the user is running themselves, and the trap fires on Ctrl-C.
CURRENT_SRV=""
# Only the run that created it may remove it: a loser releasing the winner's
# lock would let a third run in while the winner is still on the port.
release_lock() { (( ${HOLD_LOCK:-0} )) && rmdir "${PORT_LOCK:-}" 2>/dev/null; return 0; }

cleanup() {
  [[ -n "$CURRENT_SRV" ]] || return 0
  kill "$CURRENT_SRV" 2>/dev/null
  for _ in $(seq 1 15); do kill -0 "$CURRENT_SRV" 2>/dev/null || break; sleep 1; done
  kill -9 "$CURRENT_SRV" 2>/dev/null
  CURRENT_SRV=""
  sleep 1
}
trap 'cleanup; release_lock' EXIT INT TERM

# Refuse to start rather than fight over a port something else owns.
if (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; then
  exec 3<&-
  die "port $PORT is already in use — pass --port to choose another"
fi

# The check above is a moment in time, and two ctxprobes racing both pass it:
# the loser's server fails to bind, but its health check and its whole ladder
# reach the winner's server and come back PASS for a configuration that never
# ran. mkdir is atomic, so only one run holds a given port.
PORT_LOCK="${TMPDIR:-/tmp}/ctxprobe-port-$PORT.lock"
HOLD_LOCK=0
if ! mkdir "$PORT_LOCK" 2>/dev/null; then
  die "another ctxprobe holds port $PORT ($PORT_LOCK) — pass --port to choose another"
fi
HOLD_LOCK=1

RESULTS_TSV="$OUT/results.tsv"
printf 'context\tresult\tpeak_vram_mib\tprefill_tps\tgenerate_tps\tprompt_tokens\n' > "$RESULTS_TSV"

# ------------------------------------------------------------------ one trial
# Boots the server at $1 tokens and returns 0 only if it survives both prompts.
# Echoes: verdict<TAB>peak_vram<TAB>prefill_tps<TAB>gen_tps<TAB>prompt_tokens
try_ctx() {
  local ctx="$1"
  # quick: ladder to 4096 only. Every failure ever measured landed on 64 or 512
  # (MMQ_DP4A_MAX_BATCH_SIZE and n_ubatch), and batch shape stops changing past
  # n_ubatch, so filling the window during the search costs ~85% of the runtime
  # to re-test a dimension nothing has ever failed on.
  # full: adds the fill% rung. Used once, on the winner, so the number that gets
  # reported is still backed by a full-length prompt.
  local mode="${2:-quick}"
  local log="$OUT/ctx${ctx}.log"
  cleanup

  CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}" "$LLAMA_BIN" \
    -m "$MODEL" --host 127.0.0.1 --port "$PORT" \
    -ngl "$NGL" -c "$ctx" --parallel "$PARALLEL" \
    --cache-type-k "$KV" --cache-type-v "$KV" \
    ${EXTRA[@]+"${EXTRA[@]}"} > "$log" 2>&1 &
  local srv=$!
  CURRENT_SRV=$srv

  local peak=0 ready=no
  for _ in $(seq 1 300); do
    kill -0 $srv 2>/dev/null || break
    local u; u=$(smi --query-gpu=memory.used --format=csv,noheader,nounits | head -1)
    (( u > peak )) && peak=$u
    if curl -sf --max-time 2 "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
      # A healthy answer is not proof it came from our child: it dies a moment
      # after failing to bind, so the check above can pass while the reply came
      # from whatever already owned the port. /props reports the context the
      # answering server was actually started with.
      local served; served=$(curl -sf --max-time 5 "http://127.0.0.1:$PORT/props" 2>/dev/null \
        | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for k in ("n_ctx", "default_generation_settings"):
    v = d.get(k)
    if isinstance(v, int): print(v); break
    if isinstance(v, dict) and isinstance(v.get("n_ctx"), int): print(v["n_ctx"]); break' 2>/dev/null)
      if [[ -n "$served" ]] && (( served != ctx )); then
        cleanup
        echo "LOAD_FAIL|$peak||"; return 1
      fi
      ready=yes; break
    fi
    sleep 2
  done

  if [[ "$ready" != yes ]]; then
    cleanup
    echo "LOAD_FAIL|$peak||"; return 1
  fi

  # Short prompt: proves it decodes at all.
  curl -s --max-time 180 "http://127.0.0.1:$PORT/v1/chat/completions" \
    -H 'content-type: application/json' \
    -d '{"messages":[{"role":"user","content":"Write one sentence about the sea."}],"max_tokens":32}' \
    >/dev/null 2>&1

  if grep -qiE "CUDA error|ggml_abort|out of memory" "$log"; then
    cleanup
    echo "DECODE_OOM|$peak||"; return 1
  fi

  # Prompt ladder. A larger prefill instantiates CUDA kernel variants a smaller
  # one never touches, and loading one for the first time needs device memory a
  # nearly-full card has not got. Measured on this hardware, a config that dies
  # at 95% fill already dies at 64 tokens — so climbing from short to long and
  # stopping at the first death costs a fraction of always filling the window,
  # while still finishing at a full-size prompt for anything that survives.
  # It also reports *where* it died, which one long prompt cannot.
  local ok
  ok=$(python3 - "$ctx" "$PORT" "$FILL" "$mode" <<'LADDER'
import json, os, random, socket, sys, urllib.error, urllib.request
ctx, port, fill, mode = int(sys.argv[1]), sys.argv[2], int(sys.argv[3]), sys.argv[4]

GEN = 8
# The full-window prompt is given as long as it needs at this prefill rate, and
# never less than 900 s. 150 tok/s is the slowest configuration this project has
# measured (a 137 GB MoE with experts in DDR5 at the default -ub). Below that the
# run stops with TIMEOUT rather than calling a stopwatch a memory ceiling.
try:
    FILL_MIN_TPS = max(1, int(os.environ.get('CTXPROBE_FILL_MIN_TPS', '150')))
except ValueError:
    FILL_MIN_TPS = 150
target = max(1, int(ctx * fill / 100) - GEN)
vocab = "alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo lima".split()

def post(path, payload, timeout=900):
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}",
                                 data=json.dumps(payload).encode(),
                                 headers={"content-type": "application/json"})
    return json.load(urllib.request.urlopen(req, timeout=timeout))

def count(text):
    # input_tokens includes the chat template wrapper; /tokenize does not, and
    # that wrapper is what tips a near-full prompt over the limit.
    msgs = [{"role": "user", "content": text}]
    try:
        r = post("/v1/chat/completions/input_tokens", {"messages": msgs}, timeout=120)
        for k in ("input_tokens", "count", "n_tokens", "tokens"):
            v = r.get(k)
            if isinstance(v, int): return v
            if isinstance(v, list): return len(v)
    except Exception:
        pass
    try:
        return len(post("/tokenize", {"content": text}, timeout=120)["tokens"])
    except Exception:
        return None

def build(want, seed):
    rnd = random.Random(seed)
    words, text, n = max(1, want // 2), "", None
    for _ in range(8):
        text = " ".join(rnd.choice(vocab) for _ in range(words))
        n = count(text)
        if n is None:
            return " ".join(rnd.choice(vocab) for _ in range(max(1, int(want / 1.5)))), None
        if want * 0.97 <= n <= want:
            break
        words = max(1, int(words * want / max(n, 1)))
    while n is not None and n > want and words > 1:
        words = max(1, int(words * 0.97))
        text = " ".join(rnd.choice(vocab) for _ in range(words))
        n = count(text)
    return text, n

# Each rung crosses a real threshold rather than being a round number:
#   64   MMQ_DP4A_MAX_BATCH_SIZE — dp4a below it, mma at or above. Only a real
#        boundary where FP16 MMA exists: mmq.cu short-circuits to dp4a for the
#        whole range otherwise, so on older cards this rung crosses nothing
#   512  n_ubatch default — the first full micro-batch, where the pool sizes up
#   4096 past n_batch (2048), the other batching bound
# Measured failures so far land exactly on the first two.
rungs = [r for r in (64, 512, 4096) if r < target]
if mode == 'full' or not rungs:
    rungs.append(target)
used = 0
for i, rung in enumerate(rungs):
    text, n = build(rung, i)
    tmo = max(900, rung // FILL_MIN_TPS)
    try:
        r = post("/v1/chat/completions",
                 {"messages": [{"role": "user", "content": text}], "max_tokens": GEN},
                 timeout=tmo)
        usage = r.get("usage") or {}
        used = usage.get("prompt_tokens") or n or rung
        if (usage.get("completion_tokens") or 0) == 0:
            print(f"silent {used}"); break
    except (socket.timeout, TimeoutError):
        print(f"timeout {n or rung} {tmo}"); break
    except urllib.error.URLError as e:
        if isinstance(getattr(e, "reason", None), (socket.timeout, TimeoutError)):
            print(f"timeout {n or rung} {tmo}"); break
        print(f"fail {n or rung}"); break   # the rung that died is the useful part
    except Exception:
        print(f"fail {n or rung}"); break   # the rung that died is the useful part
else:
    print(f"ok {used}")
LADDER
)
  local filled=""
  case "$ok" in
    ok\ *)     filled="${ok#ok }" ;;
    silent\ *) filled="${ok#silent }" ;;
    fail\ *)   filled="died@${ok#fail }" ;;   # which rung killed it
    timeout\ *)
      read -r _tt _ts <<< "${ok#timeout }"
      filled="timeout@${_tt}/${_ts:-?}s" ;;   # tokens sent / budget, readable in results.tsv
  esac

  local u; u=$(smi --query-gpu=memory.used --format=csv,noheader,nounits | head -1)
  (( u > peak )) && peak=$u

  # Speeds come from the server's own timing lines — present regardless of how
  # the HTTP response shape changes between llama.cpp versions.
  # Both timing lines end in "(... ms per token, N tokens per second)", so they
  # must be told apart by their label first — matching the shared suffix alone
  # reports the generation rate as the prefill rate.
  local gen pre
  pre=$(grep 'prompt eval time' "$log" | tail -1 \
        | grep -oE '[0-9.]+ tokens per second' | grep -oE '^[0-9.]+')
  gen=$(grep 'eval time' "$log" | grep -v 'prompt eval' | tail -1 \
        | grep -oE '[0-9.]+ tokens per second' | grep -oE '^[0-9.]+')

  cleanup

  # A server that survives but emits nothing is not out of memory — usually it's
  # a thinking model that spent the whole budget reasoning (see gotchas.md).
  # Reporting that as an OOM sends people hunting for a memory problem.
  if [[ "$ok" == silent\ * ]] && ! grep -qiE "CUDA error|ggml_abort|out of memory" "$log"; then
    echo "SILENT|$peak|${pre:-}|${gen:-}|${filled:-}"; return 1
  fi
  # A prompt that did not finish inside the time budget, with nothing in the log,
  # is a speed result, not a memory one. Filing it as PREFILL_OOM would turn a
  # slow prefill into a false ceiling — and the bisection would then hunt for the
  # size that fits the stopwatch.
  if [[ "$ok" == timeout\ * ]] && ! grep -qiE "CUDA error|ggml_abort|out of memory" "$log"; then
    echo "TIMEOUT|$peak|${pre:-}|${gen:-}|${filled:-}"; return 1
  fi
  # PREFILL_OOM, not LONG_OOM: the killing prompt is usually 64 tokens, not a
  # long one. Naming it after length was a leftover from believing the buffers
  # grew with prompt size, and it sent people looking in the wrong place.
  if [[ "$ok" != ok\ * ]] || grep -qiE "CUDA error|ggml_abort|out of memory" "$log"; then
    echo "PREFILL_OOM|$peak|${pre:-}|${gen:-}|${filled:-}"; return 1
  fi
  echo "PASS|$peak|${pre:-}|${gen:-}|${filled:-}"; return 0
}

record() { printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
  "$1" "$2" "${3:-}" "${4:-}" "${5:-}" "${6:-}" >> "$RESULTS_TSV"; }

if (( JSON == 0 )); then
  echo "ctxprobe"
  echo "  model     : $(basename "$MODEL") ($(du -h "$MODEL" | cut -f1))"
  echo "  gpu       : $GPU_NAME (index $GPU_IDX)"
  echo "  vram      : ${VRAM_TOTAL} MiB reported by nvidia-smi, ${VRAM_BASE} MiB already in use"
  if [[ -n "$VRAM_USABLE" ]]; then
  echo "              ${VRAM_USABLE} MiB actually allocatable ($(( VRAM_TOTAL - VRAM_USABLE )) MiB is driver reserve)"
  # Report what other processes hold using nvidia-smi's figure, not the free
  # value from cudaMemGetInfo: reading that requires creating a CUDA context,
  # which itself reserves a few hundred MiB and would be counted as somebody
  # else's usage even though it is released before the run starts.
  (( VRAM_BASE > 64 )) && \
  echo "              $(( VRAM_USABLE - VRAM_BASE )) MiB free for this run (${VRAM_BASE} MiB held by other processes)"
  else
  echo "              (no torch found, so the real allocatable total is unknown —"
  echo "               nvidia-smi's figure above includes driver reserve. Set"
  echo "               CTXPROBE_PYTHON to a python that can import torch.)"
  fi
  echo "  kv cache  : $KV | slots: $PARALLEL | step: $STEP | winner validated at ${FILL}% fill"
  echo "  cuda      : CUDA_MODULE_LOADING=$CUDA_LOADING | -ngl $NGL"
  echo "  attention : flash_attn=$FLASH_ATTN"
  echo
  printf '%-10s %-11s %-11s %-10s %-10s %s\n' \
    CONTEXT RESULT PEAK_VRAM PREFILL GENERATE FILLED
  printf '%.0s-' {1..72}; echo
fi

emit() {  # ctx verdict peak prefill gen filled
  # Even in --json mode, say something: a silent hour looks like a hang.
  (( JSON == 1 )) && { printf '  %s: %s\n' "$1" "$2" >&2; return 0; }
  printf '%-10s %-11s %-11s %-10s %-10s %s\n' \
    "$1" "$2" "${3:-?}" "${4:-n/a}" "${5:-n/a}" "${6:-—}"
}

BEST=0; BEST_PRE=""; BEST_GEN=""; BEST_PEAK=""

if [[ -n "$LIST" ]]; then
  # Word-split on whitespace only: unquoted expansion would glob and would let
  # arithmetic through, so "3*" could probe a filename.
  read -ra _list <<< "$LIST"
  for c in "${_list[@]}"; do
    [[ "$c" =~ ^(0|[1-9][0-9]*)$ ]] || die "--list takes numbers, got: $c"
    c=$(round_step "$c")
    IFS='|' read -r v p pre gen fl < <(try_ctx "$c")
    emit "$c" "$v" "$p" "$pre" "$gen" "$fl"
    record "$c" "$v" "$p" "$pre" "$gen" "$fl"
    [[ "$v" == PASS ]] && (( c > BEST )) && { BEST=$c; BEST_PRE=$pre; BEST_GEN=$gen; BEST_PEAK=$p; }
  done
else
  # Binary search. lo is the largest known-good, hi the smallest known-bad.
  lo=0; hi=$(( MAX + STEP ))
  IFS='|' read -r v p pre gen fl < <(try_ctx "$MIN")
  emit "$MIN" "$v" "$p" "$pre" "$gen" "$fl"; record "$MIN" "$v" "$p" "$pre" "$gen" "$fl"
  if [[ "$v" != PASS ]]; then
    (( JSON == 0 )) && { echo; echo "Even the minimum ($MIN) does not run. Try a smaller quant or --kv q4_0."; }
    [[ $JSON == 1 ]] && printf '{"schema": 2, "model": "%s", "max_context": 0, "validated_at_fill": false}\n' \
      "$(basename "$MODEL")"
    exit 2
  fi
  lo=$MIN; BEST=$MIN; BEST_PRE=$pre; BEST_GEN=$gen; BEST_PEAK=$p

  IFS='|' read -r v p pre gen fl < <(try_ctx "$MAX")
  emit "$MAX" "$v" "$p" "$pre" "$gen" "$fl"; record "$MAX" "$v" "$p" "$pre" "$gen" "$fl"
  if [[ "$v" == PASS ]]; then
    BEST=$MAX; BEST_PRE=$pre; BEST_GEN=$gen; BEST_PEAK=$p
    lo=$MAX; hi=$(( MAX + STEP ))
  else
    hi=$MAX
    while (( hi - lo > STEP )); do
      mid=$(( (lo + hi) / 2 )); mid=$(round_step "$mid")
      (( mid <= lo )) && break
      (( mid >= hi )) && break
      IFS='|' read -r v p pre gen fl < <(try_ctx "$mid")
      emit "$mid" "$v" "$p" "$pre" "$gen" "$fl"; record "$mid" "$v" "$p" "$pre" "$gen" "$fl"
      if [[ "$v" == PASS ]]; then
        lo=$mid; BEST=$mid; BEST_PRE=$pre; BEST_GEN=$gen; BEST_PEAK=$p
      else
        hi=$mid
      fi
    done
  fi
fi

# Validate the winner once at full length. The search deliberately skipped that
# rung, and this is also the independent second run of BEST — cost is +1 boot,
# not xN, which is enough to catch an outside disturbance during the search.
#
# If that fails, the ladder and a full window disagree about the ceiling, and
# the ladder is the one that is wrong: something in this model grows with the
# number of tokens already in the cache, which no 4096-token rung can size.
# Measured once, on Qwen3.8-Flash-Next — the QSA indexer scores every cached
# block for every ubatch row, so its top-k scratch scales with n_kv, and the
# ladder passed every size up to 92K while a 95% prompt died at 5K tokens in.
# So the fallback is a second binary search, this time validating every probe
# at FILL%. It is bounded by log2(range/STEP) boots, and it ends on a size
# that actually held a full window — or on the finding that nothing did.
VALIDATED=0; LADDER_BEST=$BEST; FILL_TIMED_OUT=0; TIMEOUT_AT=""; TIMEOUT_SECS=""
# try_ctx runs in a subshell, so the size and budget of a timed-out probe come
# back through its filled field (timeout@TOKENS/SECSs), not through a variable.
note_timeout() { FILL_TIMED_OUT=1; TIMEOUT_AT=$1; TIMEOUT_SECS=${2##*/}; TIMEOUT_SECS=${TIMEOUT_SECS%s}; }
if (( BEST > 0 )); then
  (( JSON == 0 )) && { echo; echo "Validating $BEST at ${FILL}% fill..."; }
  IFS='|' read -r v p pre gen fl < <(try_ctx "$BEST" full)
  record "$BEST" "final:$v" "$p" "$pre" "$gen" "$fl"
  (( JSON == 1 )) && printf '  validate %s: %s\n' "$BEST" "$v" >&2
  if [[ "$v" == PASS ]]; then
    BEST_PEAK=$p; BEST_PRE=$pre; BEST_GEN=$gen; VALIDATED=1
    (( JSON == 0 )) && echo "  confirmed: $BEST ($fl tokens filled)"
  elif [[ "$v" == TIMEOUT ]]; then
    # Not a memory verdict, so there is nothing to bisect towards: a smaller size
    # that finishes in time would be a speed ceiling wearing a memory label.
    note_timeout "$BEST" "$fl"
    (( JSON == 0 )) && {
      echo "  $BEST did not finish a ${FILL}% prompt in ${TIMEOUT_SECS:-?} s"
      echo "  (budget assumes >= ${CTXPROBE_FILL_MIN_TPS:-150} tok/s prefill; the server was still"
      echo "  alive and the log is clean, so this is speed, not memory). Not bisecting."
    }
  else
    (( JSON == 0 )) && {
      echo "  $BEST failed at ${FILL}% fill ($v)"
      echo "  The ladder cleared it and a full window did not, so a buffer in this"
      echo "  model grows with the tokens already cached — sparse attention with an"
      echo "  indexer does this. Bisecting for the size that holds a full window:"
    }
    # hi is known to fail at fill. lo starts one step under the search floor,
    # meaning "nothing known below"; it becomes a real floor only once a probe
    # passes at fill. Every probe here is a full boot plus a FILL% prompt.
    # Floor: one step below the smallest size this run would ever have tried,
    # so --list (which ignores MIN) does not make the bisection skip past the
    # answer. Cap: derived from the range, since a small --step over a wide one
    # needs more than a constant number of halvings.
    floor=$MIN
    if [[ -n "$LIST" ]]; then
      floor=$BEST
      for c in "${_list[@]}"; do (( c < floor )) && floor=$c; done
      floor=$(( (floor / STEP) * STEP ))
      (( floor >= STEP )) || floor=$STEP
    fi
    hi=$BEST; lo=$(( floor - STEP )); LO_OK=0; _n=0
    _cap=1; _span=$(( (hi - lo) / STEP ))
    while (( _span > 1 )); do _span=$(( _span / 2 )); _cap=$(( _cap + 1 )); done
    (( _cap < 4 )) && _cap=4
    while (( hi - lo > STEP && _n < _cap )); do
      mid=$(( (lo + hi) / 2 )); mid=$(( mid / STEP * STEP ))
      (( mid <= lo )) && mid=$(( lo + STEP ))
      (( mid >= hi )) && break
      (( mid < STEP )) && break
      _n=$(( _n + 1 ))
      IFS='|' read -r v p pre gen fl < <(try_ctx "$mid" full)
      record "$mid" "final:$v" "$p" "$pre" "$gen" "$fl"
      (( JSON == 1 )) && printf '  validate %s: %s\n' "$mid" "$v" >&2
      if [[ "$v" == PASS ]]; then
        lo=$mid; LO_OK=1; BEST_PEAK=$p; BEST_PRE=$pre; BEST_GEN=$gen
        (( JSON == 0 )) && echo "  $mid holds at ${FILL}% fill ($fl tokens filled)"
      elif [[ "$v" == TIMEOUT ]]; then
        note_timeout "$mid" "$fl"
        (( JSON == 0 )) && echo "  $mid did not finish in ${TIMEOUT_SECS:-?} s — stopping; a timeout is not a memory edge"
        break
      else
        hi=$mid
        (( JSON == 0 )) && echo "  $mid failed at ${FILL}% fill ($v)"
      fi
    done
    if (( LO_OK == 1 )); then
      BEST=$lo; VALIDATED=1
      (( JSON == 0 )) && {
        echo "  confirmed: $BEST — the ladder had said $LADDER_BEST,"
        echo "  $(( LADDER_BEST - BEST )) tokens too high"
        (( FILL_TIMED_OUT )) && echo "  (a larger probe timed out, so the true edge may sit above $BEST)"
      }
    elif (( FILL_TIMED_OUT == 1 )); then
      (( JSON == 0 )) && {
        echo "  no size was confirmed: $LADDER_BEST failed at ${FILL}% fill and the bisection"
        echo "  stopped at $TIMEOUT_AT on a timeout. Set CTXPROBE_FILL_MIN_TPS lower (or raise -ub)"
        echo "  and re-run to find the edge below $LADDER_BEST."
      }
    else
      (( JSON == 0 )) && {
        echo "  nothing between $MIN and $LADDER_BEST survived a ${FILL}% prompt."
        echo "  Re-run with --keep --list \"$LADDER_BEST\" and read the log; the"
        echo "  backtrace names the op whose working set grows with the window."
      }
    fi
  fi
fi

(( KEEP == 0 )) && find "$OUT" -name 'ctx*.log' -delete 2>/dev/null

if (( JSON == 1 )); then
  python3 - "$MODEL" "$GPU_NAME" "$BEST" "$BEST_PEAK" "$BEST_PRE" "$BEST_GEN" \
           "$KV" "$PARALLEL" "$VRAM_TOTAL" "${VRAM_USABLE:-}" "$NGL" "$FILL" \
           "$CUDA_LOADING" "$VRAM_BASE" "$FLASH_ATTN" "$VALIDATED" "$LADDER_BEST" \
           "$FILL_TIMED_OUT" <<'PY'
import json, os, sys
(m, gpu, best, peak, pre, gen, kv, par, total, usable,
 ngl, fill, cuda_loading, free, flash_attn, validated, ladder_best,
 fill_timed_out) = sys.argv[1:19]
print(json.dumps({
    # Bump when the shape of this object changes, so collected results stay
    # interpretable once several machines have contributed.
    "schema": 4,
    "model": os.path.basename(m), "gpu": gpu,
    "max_context": int(best),
    # False means the search ladder cleared this size but a prompt filling
    # fill_percent of the window did not. max_context is then unconfirmed.
    "validated_at_fill": validated == "1",
    # What the 64/512/4096 ladder alone would have reported. Equal to
    # max_context unless a full window failed and the search bisected down.
    "ladder_max_context": int(ladder_best),
    # True when the full-window prompt hit its time budget with the server still
    # healthy. max_context is then unconfirmed for speed reasons, not memory.
    "fill_timed_out": fill_timed_out == "1",
    "peak_vram_mib": int(peak) if peak else None,
    "prefill_tps": float(pre) if pre else None,
    "generate_tps": float(gen) if gen else None,
    "kv_cache_type": kv, "slots": int(par), "n_gpu_layers": int(ngl),
    "fill_percent": int(fill),
    "cuda_module_loading": cuda_loading,
    "flash_attn": flash_attn,
    "vram_total_mib": int(total),
    "vram_allocatable_mib": int(usable) if usable else None,
    "vram_held_by_others_mib": int(free) if free else None,
}, indent=2))
PY
else
  echo
  if (( BEST > 0 )); then
    SAFE=$(( BEST - 2 * STEP )); (( SAFE < STEP )) && SAFE=$BEST
    if (( VALIDATED == 1 )); then
      echo "Largest context that actually runs: $BEST tokens"
      (( LADDER_BEST > BEST )) && \
      echo "  the ladder cleared $LADDER_BEST; only a ${FILL}% prompt found the real edge"
      (( FILL_TIMED_OUT )) && \
      echo "  a larger probe timed out (>= ${CTXPROBE_FILL_MIN_TPS:-150} tok/s assumed); the edge may be higher"
    elif (( FILL_TIMED_OUT == 1 )); then
      echo "Largest context that cleared the ladder: $BEST tokens (UNCONFIRMED — timed out)"
      if [[ "$TIMEOUT_AT" == "$BEST" ]]; then
        echo "  a prompt filling ${FILL}% of the window did not finish in ${TIMEOUT_SECS:-?} s."
      else
        echo "  it failed at ${FILL}% fill, and the bisection below it stopped when"
        echo "  $TIMEOUT_AT did not finish in ${TIMEOUT_SECS:-?} s."
      fi
      echo "  That budget assumes >= ${CTXPROBE_FILL_MIN_TPS:-150} tok/s of prefill. This is not a"
      echo "  memory result: raise -ub (see docs/gotchas.md #7) or set"
      echo "  CTXPROBE_FILL_MIN_TPS lower to wait longer, then re-run."
    else
      echo "Largest context that cleared the ladder: $BEST tokens (UNCONFIRMED)"
      echo "  it did not survive a prompt filling ${FILL}% of the window"
    fi
    echo "  peak VRAM ${BEST_PEAK:-?} MiB | prefill ${BEST_PRE:-?} tok/s | generate ${BEST_GEN:-?} tok/s"
    echo
    echo "That is a ceiling, not a recommendation: it passed at ${FILL}% fill with"
    echo "nothing to spare. Anything else touching the card — a desktop, a second"
    echo "process — puts it over. For day-to-day use back off a couple of steps:"
    echo
    printf '  llama-server -m %q -ngl %s -c %s \\\n' "$MODEL" "$NGL" "$SAFE"
    printf '    --cache-type-k %s --cache-type-v %s --parallel %s' "$KV" "$KV" "$PARALLEL"
    (( ${#EXTRA[@]} )) && printf ' %q' "${EXTRA[@]}"
    printf '\n'
    echo
    echo "Use -c $BEST only if this GPU is doing nothing else."
    if (( EAGER == 0 )); then
      echo
      echo "This number assumes the kernels this run happened to touch are all"
      echo "your workload will ever touch. Re-run with --eager for a ceiling that"
      echo "holds regardless — smaller, but a property of the config rather than"
      echo "of the test."
    fi 
  else
    echo "No context size passed."
  fi
  echo
  echo "PASS         cleared the prompt ladder — 64, 512 and 4096 tokens, or as"
  echo "             many of those rungs as the window holds. Only the winner is"
  echo "             re-tested at ${FILL}% of the window"
  echo "LOAD_FAIL    never became healthy; the model or its KV cache didn't fit"
  echo "DECODE_OOM   loaded, then died on the 18-token warm-up prompt"
  echo "PREFILL_OOM  died on a ladder rung; FILLED says which one. Usually 64"
  echo "             tokens, not a long prompt — see docs/gotchas.md"
  echo "TIMEOUT      the full-window prompt did not finish inside its time budget"
  echo "             and the server is fine — a speed result, never a memory one"
  echo "SILENT       ran without crashing but produced no tokens; usually a"
  echo "             thinking model spending its budget on reasoning, not memory"
  echo
  echo "Speeds in the table come from the last rung a run reached, so they"
  echo "describe a lightly-loaded window. The figures for the winner above come"
  echo "from the ${FILL}% validation and are the ones to quote."
  echo
  echo "Per-run data: $RESULTS_TSV"
fi
