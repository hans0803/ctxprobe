#!/usr/bin/env bash
# ctxprobe — find the largest context a GGUF actually runs at on one GPU.
#
# Estimators tell you a context size should fit. ctxprobe proves it runs:
# every candidate is booted for real, given a short prompt, and then given a
# prompt that fills most of the window. A larger prefill instantiates CUDA
# kernels a short prompt never touches, and loading one for the first time needs
# device memory a nearly-full card doesn't have — so a config can load fine,
# decode a short prompt at full speed, and still CUDA-OOM on a real one.
#
# Usage:
#   ctxprobe MODEL.gguf [options] [-- extra llama-server args]
#
# Options:
#   --min N           lower bound for the search (default 2048)
#   --max N           upper bound (default: model's trained context, capped 131072)
#   --step N          granularity (default 256 — llama.cpp pads n_ctx to 256)
#   --kv TYPE         KV cache type: q8_0 (default), f16, q4_0, ...
#   --parallel N      server slots (default 1; the default of 4 quadruples KV)
#   --ngl N           layers on GPU (default 999 = all). Lower values spill to
#                     system RAM — useful for measuring what overflow costs,
#                     but then a PASS no longer means "ran entirely on the GPU"
#   --list "A B C"    test these sizes instead of binary-searching
#   --fill PCT        how full the long prompt should be, 0-100 (default 95).
#                     Measured with the server tokenizer, so it is the real figure
#   --port N          port for the probe server (default 6099)
#   --out DIR         where logs go (default ./ctxprobe-out)
#   --eager           set CUDA_MODULE_LOADING=EAGER: loads every kernel up front
#                     so the answer doesn't depend on which kernels this run
#                     happened to touch. Gives a smaller but portable ceiling
#   --json            emit machine-readable JSON to stdout
#   --keep            don't delete per-run logs
set -uo pipefail

die() { echo "ctxprobe: $*" >&2; exit 1; }

MODEL=""; MIN=2048; MAX=""; STEP=256; KV="q8_0"; PARALLEL=1; NGL=999
LIST=""; FILL=95; PORT=6099; OUT="./ctxprobe-out"; JSON=0; KEEP=0; EAGER=0
EXTRA=()   # expanded as ${EXTRA[@]+...} so bash 3.2 tolerates it empty under set -u

val() {  # val <flag> <value?> — reject a missing or non-numeric argument
  [[ -n "${2:-}" ]] || die "$1 needs a value"
  case "$1" in
    --kv) ;;
    *) [[ "$2" =~ ^[0-9]+$ ]] || die "$1 needs a number, got: $2" ;;
  esac
  printf '%s' "$2"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --min) MIN=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --max) MAX=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --step) STEP=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --kv) KV=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --parallel) PARALLEL=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --ngl) NGL=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --list) [[ -n "${2:-}" ]] || die "--list needs a value"; LIST="$2"; shift 2 ;;
    --fill) FILL=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --port) PORT=$(val "$1" "${2:-}") || exit 1; shift 2 ;;
    --out) [[ -n "${2:-}" ]] || die "--out needs a value"; OUT="$2"; shift 2 ;;
    --eager) EAGER=1; shift ;;
    --json) JSON=1; shift ;;
    --keep) KEEP=1; shift ;;
    -h|--help) sed -n '2,/^set /p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; EXTRA=("$@"); break ;;
    -*) die "unknown option: $1" ;;
    *) [[ -z "$MODEL" ]] && MODEL="$1" || die "unexpected argument: $1"; shift ;;
  esac
done

[[ -n "$MODEL" ]] || die "usage: ctxprobe MODEL.gguf [options]  (--help for more)"
[[ -f "$MODEL" ]] || die "model not found: $MODEL"

LLAMA_BIN="${LLAMA_SERVER:-$(command -v llama-server || echo "$HOME/llama.cpp/build/bin/llama-server")}"
[[ -x "$LLAMA_BIN" ]] || die "llama-server not found. Set LLAMA_SERVER=/path/to/llama-server"
command -v nvidia-smi >/dev/null || die "nvidia-smi not found (NVIDIA GPU required)"
command -v python3   >/dev/null || die "python3 required"

mkdir -p "$OUT"

# --------------------------------------------------------------- capabilities
# nvidia-smi's total includes a driver reserve that no allocation can touch
# (~460 MiB on a 16 GB card). Headroom measured against it is fiction, so ask
# CUDA what it really exposes when a torch build happens to be available.
VRAM_TOTAL=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits | head -1)
VRAM_BASE=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | head -1)
read_usable() {
  # Must be cudaMemGetInfo, which is what CUDA will actually hand out.
  # NVML/nvidia-smi report the physical size of the board instead — using those
  # yields a driver reserve of 0 and hides the very gap this is here to expose.
  # Reports free as well as total: they diverge whenever something else already
  # holds memory on the card, and it is free that bounds this run.
  local snippet='import torch
f, t = torch.cuda.mem_get_info()
print(int(f / 2**20), int(t / 2**20))'
  local py
  for py in "${CTXPROBE_PYTHON:-}" python3 \
            "$HOME/miniconda3/envs/"*/bin/python "$HOME/venv/bin/python" ; do
    [[ -n "$py" && -x "$(command -v "$py" 2>/dev/null)" ]] || continue
    local v; v=$("$py" -c "$snippet" 2>/dev/null)
    [[ -n "$v" ]] && { echo "$v"; return 0; }
  done
  return 1
}
VRAM_INFO=$(read_usable || true)
VRAM_FREE=${VRAM_INFO% *}; VRAM_USABLE=${VRAM_INFO#* }
[[ "$VRAM_INFO" == *" "* ]] || { VRAM_FREE=""; VRAM_USABLE=""; }
GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -1)
# Lazy vs eager module loading decides when a kernel's code is pulled into VRAM,
# which moves the ceiling. Two machines set differently give different answers,
# so record it rather than leaving the discrepancy unexplained.
(( EAGER )) && export CUDA_MODULE_LOADING=EAGER
CUDA_LOADING="${CUDA_MODULE_LOADING:-LAZY (default)}"

# Trained context length, so --max defaults to something the model supports.
if [[ -z "$MAX" ]]; then
  MAX=$(python3 - "$MODEL" <<'PY' 2>/dev/null || true
import struct, sys
# Minimal GGUF reader: walk the KV table looking for *.context_length.
f = open(sys.argv[1], 'rb')
if f.read(4) != b'GGUF': sys.exit(1)
ver = struct.unpack('<I', f.read(4))[0]
n_tensors, n_kv = struct.unpack('<QQ', f.read(16))
def rd_str():
    (n,) = struct.unpack('<Q', f.read(8)); return f.read(n).decode('utf-8', 'replace')
SCALAR = {0:'<b',1:'<B',2:'<h',3:'<H',4:'<i',5:'<I',6:'<f',7:'<?',10:'<q',11:'<Q',12:'<d'}
SIZE   = {0:1,1:1,2:2,3:2,4:4,5:4,6:4,7:1,10:8,11:8,12:8}
def rd_val(t):
    if t == 8: return rd_str()
    if t == 9:
        (et,) = struct.unpack('<I', f.read(4)); (n,) = struct.unpack('<Q', f.read(8))
        return [rd_val(et) for _ in range(n)]
    return struct.unpack(SCALAR[t], f.read(SIZE[t]))[0]
for _ in range(n_kv):
    k = rd_str(); (t,) = struct.unpack('<I', f.read(4)); v = rd_val(t)
    if k.endswith('.context_length'):
        print(min(int(v), 131072)); sys.exit(0)
sys.exit(1)
PY
)
  [[ -n "$MAX" ]] || MAX=32768
fi

round_step() { echo $(( ($1 / STEP) * STEP )); }
MIN=$(round_step "$MIN"); MAX=$(round_step "$MAX")
(( MIN >= STEP )) || MIN=$STEP
(( MAX > MIN )) || die "--max ($MAX) must exceed --min ($MIN)"

# Only ever kill the server this script started. Matching on the port would also
# take out a server the user is running themselves, and the trap fires on Ctrl-C.
CURRENT_SRV=""
cleanup() {
  [[ -n "$CURRENT_SRV" ]] || return 0
  kill "$CURRENT_SRV" 2>/dev/null
  for _ in $(seq 1 15); do kill -0 "$CURRENT_SRV" 2>/dev/null || break; sleep 1; done
  kill -9 "$CURRENT_SRV" 2>/dev/null
  CURRENT_SRV=""
  sleep 1
}
trap cleanup EXIT INT TERM

# Refuse to start rather than fight over a port something else owns.
if (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; then
  exec 3<&-
  die "port $PORT is already in use — pass --port to choose another"
fi

RESULTS_TSV="$OUT/results.tsv"
printf 'context\tresult\tpeak_vram_mib\tprefill_tps\tgenerate_tps\tprompt_tokens\n' > "$RESULTS_TSV"

# ------------------------------------------------------------------ one trial
# Boots the server at $1 tokens and returns 0 only if it survives both prompts.
# Echoes: verdict<TAB>peak_vram<TAB>prefill_tps<TAB>gen_tps<TAB>prompt_tokens
try_ctx() {
  local ctx="$1"
  local log="$OUT/ctx${ctx}.log"
  cleanup

  CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}" "$LLAMA_BIN" \
    -m "$MODEL" --host 127.0.0.1 --port "$PORT" \
    -ngl "$NGL" -c "$ctx" --parallel "$PARALLEL" \
    --cache-type-k "$KV" --cache-type-v "$KV" \
    ${EXTRA[@]+"${EXTRA[@]}"} > "$log" 2>&1 &
  local srv=$!
  CURRENT_SRV=$srv

  local peak=0 ready=no
  for _ in $(seq 1 300); do
    kill -0 $srv 2>/dev/null || break
    local u; u=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | head -1)
    (( u > peak )) && peak=$u
    if curl -sf --max-time 2 "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then ready=yes; break; fi
    sleep 2
  done

  if [[ "$ready" != yes ]]; then
    cleanup
    echo -e "LOAD_FAIL\t$peak\t\t"; return 1
  fi

  # Short prompt: proves it decodes at all.
  curl -s --max-time 180 "http://127.0.0.1:$PORT/v1/chat/completions" \
    -H 'content-type: application/json' \
    -d '{"messages":[{"role":"user","content":"Write one sentence about the sea."}],"max_tokens":32}' \
    >/dev/null 2>&1

  if grep -qiE "CUDA error|ggml_abort|out of memory" "$log"; then
    cleanup
    echo -e "DECODE_OOM\t$peak\t\t"; return 1
  fi

  # Prompt ladder. A larger prefill instantiates CUDA kernel variants a smaller
  # one never touches, and loading one for the first time needs device memory a
  # nearly-full card has not got. Measured on this hardware, a config that dies
  # at 95% fill already dies at 64 tokens — so climbing from short to long and
  # stopping at the first death costs a fraction of always filling the window,
  # while still finishing at a full-size prompt for anything that survives.
  # It also reports *where* it died, which one long prompt cannot.
  local ok
  ok=$(python3 - "$ctx" "$PORT" "$FILL" <<'LADDER'
import json, random, sys, urllib.request
ctx, port, fill = int(sys.argv[1]), sys.argv[2], int(sys.argv[3])

GEN = 8
target = max(1, int(ctx * fill / 100) - GEN)
vocab = "alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo lima".split()

def post(path, payload, timeout=900):
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}",
                                 data=json.dumps(payload).encode(),
                                 headers={"content-type": "application/json"})
    return json.load(urllib.request.urlopen(req, timeout=timeout))

def count(text):
    # input_tokens includes the chat template wrapper; /tokenize does not, and
    # that wrapper is what tips a near-full prompt over the limit.
    msgs = [{"role": "user", "content": text}]
    try:
        r = post("/v1/chat/completions/input_tokens", {"messages": msgs}, timeout=120)
        for k in ("input_tokens", "count", "n_tokens", "tokens"):
            v = r.get(k)
            if isinstance(v, int): return v
            if isinstance(v, list): return len(v)
    except Exception:
        pass
    try:
        return len(post("/tokenize", {"content": text}, timeout=120)["tokens"])
    except Exception:
        return None

def build(want, seed):
    rnd = random.Random(seed)
    words, text, n = max(1, want // 2), "", None
    for _ in range(8):
        text = " ".join(rnd.choice(vocab) for _ in range(words))
        n = count(text)
        if n is None:
            return " ".join(rnd.choice(vocab) for _ in range(max(1, int(want / 1.5)))), None
        if want * 0.97 <= n <= want:
            break
        words = max(1, int(words * want / max(n, 1)))
    while n is not None and n > want and words > 1:
        words = max(1, int(words * 0.97))
        text = " ".join(rnd.choice(vocab) for _ in range(words))
        n = count(text)
    return text, n

rungs = [r for r in (64, 512, 4096) if r < target] + [target]
used = 0
for i, rung in enumerate(rungs):
    text, n = build(rung, i)
    try:
        r = post("/v1/chat/completions",
                 {"messages": [{"role": "user", "content": text}], "max_tokens": GEN})
        usage = r.get("usage") or {}
        used = usage.get("prompt_tokens") or n or rung
        if (usage.get("completion_tokens") or 0) == 0:
            print(f"silent {used}"); break
    except Exception:
        print(f"fail {n or rung}"); break   # the rung that died is the useful part
else:
    print(f"ok {used}")
LADDER
)
  local filled=""
  case "$ok" in
    ok\ *)     filled="${ok#ok }" ;;
    silent\ *) filled="${ok#silent }" ;;
    fail\ *)   filled="died@${ok#fail }" ;;   # which rung killed it
  esac

  local u; u=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | head -1)
  (( u > peak )) && peak=$u

  # Speeds come from the server's own timing lines — present regardless of how
  # the HTTP response shape changes between llama.cpp versions.
  # Both timing lines end in "(... ms per token, N tokens per second)", so they
  # must be told apart by their label first — matching the shared suffix alone
  # reports the generation rate as the prefill rate.
  local gen pre
  pre=$(grep 'prompt eval time' "$log" | tail -1 \
        | grep -oE '[0-9.]+ tokens per second' | grep -oE '^[0-9.]+')
  gen=$(grep 'eval time' "$log" | grep -v 'prompt eval' | tail -1 \
        | grep -oE '[0-9.]+ tokens per second' | grep -oE '^[0-9.]+')

  cleanup

  # A server that survives but emits nothing is not out of memory — usually it's
  # a thinking model that spent the whole budget reasoning (see gotchas.md).
  # Reporting that as LONG_OOM sends people hunting for a memory problem.
  if [[ "$ok" == silent\ * ]] && ! grep -qiE "CUDA error|ggml_abort|out of memory" "$log"; then
    echo -e "SILENT\t$peak\t${pre:-}\t${gen:-}\t${filled:-}"; return 1
  fi
  if [[ "$ok" != ok\ * ]] || grep -qiE "CUDA error|ggml_abort|out of memory" "$log"; then
    echo -e "LONG_OOM\t$peak\t${pre:-}\t${gen:-}\t${filled:-}"; return 1
  fi
  echo -e "PASS\t$peak\t${pre:-}\t${gen:-}\t${filled:-}"; return 0
}

record() { printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
  "$1" "$2" "${3:-}" "${4:-}" "${5:-}" "${6:-}" >> "$RESULTS_TSV"; }

if (( JSON == 0 )); then
  echo "ctxprobe"
  echo "  model     : $(basename "$MODEL") ($(du -h "$MODEL" | cut -f1))"
  echo "  gpu       : $GPU_NAME"
  echo "  vram      : ${VRAM_TOTAL} MiB reported by nvidia-smi, ${VRAM_BASE} MiB already in use"
  if [[ -n "$VRAM_USABLE" ]]; then
  echo "              ${VRAM_USABLE} MiB actually allocatable ($(( VRAM_TOTAL - VRAM_USABLE )) MiB is driver reserve)"
  # Report what other processes hold using nvidia-smi's figure, not the free
  # value from cudaMemGetInfo: reading that requires creating a CUDA context,
  # which itself reserves a few hundred MiB and would be counted as somebody
  # else's usage even though it is released before the run starts.
  (( VRAM_BASE > 64 )) && \
  echo "              $(( VRAM_USABLE - VRAM_BASE )) MiB free for this run (${VRAM_BASE} MiB held by other processes)"
  else
  echo "              (no torch found, so the real allocatable total is unknown —"
  echo "               nvidia-smi's figure above includes driver reserve. Set"
  echo "               CTXPROBE_PYTHON to a python that can import torch.)"
  fi
  echo "  kv cache  : $KV | slots: $PARALLEL | step: $STEP | long prompt fills ${FILL}%"
  echo "  cuda      : CUDA_MODULE_LOADING=$CUDA_LOADING | -ngl $NGL"
  echo
  printf '%-10s %-11s %-11s %-10s %-10s %s\n' \
    CONTEXT RESULT PEAK_VRAM PREFILL GENERATE FILLED
  printf '%.0s-' {1..72}; echo
fi

emit() {  # ctx verdict peak prefill gen filled
  # Even in --json mode, say something: a silent hour looks like a hang.
  (( JSON == 1 )) && { printf '  %s: %s\n' "$1" "$2" >&2; return 0; }
  printf '%-10s %-11s %-11s %-10s %-10s %s\n' \
    "$1" "$2" "${3:-?}" "${4:-n/a}" "${5:-n/a}" "${6:-—}"
}

BEST=0; BEST_PRE=""; BEST_GEN=""; BEST_PEAK=""

if [[ -n "$LIST" ]]; then
  for c in $LIST; do
    c=$(round_step "$c")
    IFS=$'\t' read -r v p pre gen fl < <(try_ctx "$c")
    emit "$c" "$v" "$p" "$pre" "$gen" "$fl"
    record "$c" "$v" "$p" "$pre" "$gen" "$fl"
    [[ "$v" == PASS ]] && (( c > BEST )) && { BEST=$c; BEST_PRE=$pre; BEST_GEN=$gen; BEST_PEAK=$p; }
  done
else
  # Binary search. lo is the largest known-good, hi the smallest known-bad.
  lo=0; hi=$(( MAX + STEP ))
  IFS=$'\t' read -r v p pre gen fl < <(try_ctx "$MIN")
  emit "$MIN" "$v" "$p" "$pre" "$gen" "$fl"; record "$MIN" "$v" "$p" "$pre" "$gen" "$fl"
  if [[ "$v" != PASS ]]; then
    (( JSON == 0 )) && { echo; echo "Even the minimum ($MIN) does not run. Try a smaller quant or --kv q4_0."; }
    [[ $JSON == 1 ]] && echo "{\"model\":\"$(basename "$MODEL")\",\"max_context\":0}"
    exit 2
  fi
  lo=$MIN; BEST=$MIN; BEST_PRE=$pre; BEST_GEN=$gen; BEST_PEAK=$p

  IFS=$'\t' read -r v p pre gen fl < <(try_ctx "$MAX")
  emit "$MAX" "$v" "$p" "$pre" "$gen" "$fl"; record "$MAX" "$v" "$p" "$pre" "$gen" "$fl"
  if [[ "$v" == PASS ]]; then
    BEST=$MAX; BEST_PRE=$pre; BEST_GEN=$gen; BEST_PEAK=$p
    lo=$MAX; hi=$(( MAX + STEP ))
  else
    hi=$MAX
    while (( hi - lo > STEP )); do
      mid=$(( (lo + hi) / 2 )); mid=$(round_step "$mid")
      (( mid <= lo )) && break
      (( mid >= hi )) && break
      IFS=$'\t' read -r v p pre gen fl < <(try_ctx "$mid")
      emit "$mid" "$v" "$p" "$pre" "$gen" "$fl"; record "$mid" "$v" "$p" "$pre" "$gen" "$fl"
      if [[ "$v" == PASS ]]; then
        lo=$mid; BEST=$mid; BEST_PRE=$pre; BEST_GEN=$gen; BEST_PEAK=$p
      else
        hi=$mid
      fi
    done
  fi
fi

(( KEEP == 0 )) && find "$OUT" -name 'ctx*.log' -delete 2>/dev/null

if (( JSON == 1 )); then
  python3 - "$MODEL" "$GPU_NAME" "$BEST" "$BEST_PEAK" "$BEST_PRE" "$BEST_GEN" \
           "$KV" "$PARALLEL" "$VRAM_TOTAL" "${VRAM_USABLE:-}" "$NGL" "$FILL" \
           "$CUDA_LOADING" "$VRAM_BASE" <<'PY'
import json, os, sys
(m, gpu, best, peak, pre, gen, kv, par, total, usable,
 ngl, fill, cuda_loading, free) = sys.argv[1:15]
print(json.dumps({
    # Bump when the shape of this object changes, so collected results stay
    # interpretable once several machines have contributed.
    "schema": 1,
    "model": os.path.basename(m), "gpu": gpu,
    "max_context": int(best),
    "peak_vram_mib": int(peak) if peak else None,
    "prefill_tps": float(pre) if pre else None,
    "generate_tps": float(gen) if gen else None,
    "kv_cache_type": kv, "slots": int(par), "n_gpu_layers": int(ngl),
    "fill_percent": int(fill),
    "cuda_module_loading": cuda_loading,
    "vram_total_mib": int(total),
    "vram_allocatable_mib": int(usable) if usable else None,
    "vram_held_by_others_mib": int(free) if free else None,
}, indent=2))
PY
else
  echo
  if (( BEST > 0 )); then
    SAFE=$(( BEST - 2 * STEP )); (( SAFE < STEP )) && SAFE=$BEST
    echo "Largest context that actually runs: $BEST tokens"
    echo "  peak VRAM ${BEST_PEAK:-?} MiB | prefill ${BEST_PRE:-?} tok/s | generate ${BEST_GEN:-?} tok/s"
    echo
    echo "That is a ceiling, not a recommendation: it passed at ${FILL}% fill with"
    echo "nothing to spare. Anything else touching the card — a desktop, a second"
    echo "process — puts it over. For day-to-day use back off a couple of steps:"
    echo
    echo "  llama-server -m $MODEL -ngl $NGL -c $SAFE \\"
    echo "    --cache-type-k $KV --cache-type-v $KV --parallel $PARALLEL${EXTRA[*]:+ ${EXTRA[*]}}"
    echo
    echo "Use -c $BEST only if this GPU is doing nothing else."
    if (( EAGER == 0 )); then
      echo
      echo "This number assumes the kernels this run happened to touch are all"
      echo "your workload will ever touch. Re-run with --eager for a ceiling that"
      echo "holds regardless — smaller, but a property of the config rather than"
      echo "of the test."
    fi 
  else
    echo "No context size passed."
  fi
  echo
  echo "PASS      cleared every rung: 64, 512, 4096 and ${FILL}% of the window"
  echo "LONG_OOM  a short prompt was fine but a longer one crashed it — the gap"
  echo "          that makes load-time estimates insufficient"
  echo "SILENT    ran without crashing but produced no tokens; usually a thinking"
  echo "          model spending its budget on reasoning, not a memory problem"
  echo
  echo "Per-run data: $RESULTS_TSV"
fi
